# ─────────────────────────────────────────────
# Solar Tracker — Environment Configuration
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Application ───────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────
# SQLite (default for development)
DATABASE_URL=sqlite:///./solar_tracker.db
# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/solar_tracker

# ── ESP32 Hardware ────────────────────────────
ESP32_IP=192.168.1.100
ESP32_PORT=80
ESP32_API_KEY=change_this_to_a_random_string
ESP32_TIMEOUT_SECONDS=3
ESP32_POLL_INTERVAL_SECONDS=10
DEVICE_OFFLINE_THRESHOLD_SECONDS=60

# ── Tracking Logic ────────────────────────────
MOVEMENT_THRESHOLD_DEGREES=3.0
MIN_PANEL_ANGLE=0.0
MAX_PANEL_ANGLE=70.0
# 60s recommended for demo mode (charts populate quickly)
# 600s (10 min) recommended for real hardware
TRACKING_INTERVAL_SECONDS=60

# ── Location (used for solar geometry) ────────
SITE_LATITUDE=20.5937
SITE_LONGITUDE=78.9629
SITE_ALTITUDE_M=300
SITE_TIMEZONE=Asia/Kolkata

# ── ML Model ──────────────────────────────────
MODEL_PATH=../ml/models/xgboost_irradiance.joblib
SCALER_PATH=../ml/models/scaler.joblib
MODEL_META_PATH=../ml/models/model_meta.json

# ── Demo Mode ─────────────────────────────────
DEMO_MODE=true

# ── Security ──────────────────────────────────
BACKEND_API_KEY=change_this_to_a_random_string

# ── Cost / Energy assumptions ─────────────────
ELECTRICITY_TARIFF_PER_KWH=8.0
CURRENCY_SYMBOL=₹
